{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  // Address of the main Raspberry Pi on the booth network. Replaces {BoothPi} in the URLs below.
  "BoothPi": "192.168.10.1",
  // Parts of the demo that expose HTTP. The health check expects HTTP 200 from Url + HealthPath.
  "HttpServices": {
    "rabbitmq": { "Url": "http://{BoothPi}:15672", "HealthPath": "/" },
    "servicecontrol": { "Url": "http://{BoothPi}:33333", "HealthPath": "/api/" },
    "servicecontrol-audit": { "Url": "http://{BoothPi}:44444", "HealthPath": "/api/" },
    "servicecontrol-monitoring": { "Url": "http://{BoothPi}:33633", "HealthPath": "/" },
    "otel-collector": { "Url": "http://{BoothPi}:13133", "HealthPath": "/" },
    "prometheus": { "Url": "http://{BoothPi}:9090", "HealthPath": "/-/healthy" },
    "grafana": { "Url": "http://{BoothPi}:3000", "HealthPath": "/api/health" },
    "azure-servicepulse": { "Url": "https://servicepulse.greenwater-803a0fdc.westeurope.azurecontainerapps.io", "HealthPath": "/" },
    // ServiceControl and Monitoring are internal to Azure; ServicePulse proxies their APIs
    "azure-servicecontrol": { "Url": "https://servicepulse.greenwater-803a0fdc.westeurope.azurecontainerapps.io", "HealthPath": "/api/" },
    "azure-servicecontrol-monitoring": { "Url": "https://servicepulse.greenwater-803a0fdc.westeurope.azurecontainerapps.io", "HealthPath": "/monitoring-api/" }
  },
  // Parts of the demo without HTTP, checked by opening a TCP connection (host:port)
  "TcpServices": {
    "postgres": "{BoothPi}:54320"
  }
}
