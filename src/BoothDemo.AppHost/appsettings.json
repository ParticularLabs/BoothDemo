{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  // Parts of the demo that expose HTTP. The health check expects HTTP 200 from Url + HealthPath.
  "HttpServices": {
    "servicepulse": { "Url": "https://servicepulse.greenwater-803a0fdc.westeurope.azurecontainerapps.io", "HealthPath": "/" },
    // ServiceControl and Monitoring are internal to Azure; ServicePulse proxies their APIs
    "servicecontrol": { "Url": "https://servicepulse.greenwater-803a0fdc.westeurope.azurecontainerapps.io", "HealthPath": "/api/" },
    "servicecontrol-monitoring": { "Url": "https://servicepulse.greenwater-803a0fdc.westeurope.azurecontainerapps.io", "HealthPath": "/monitoring-api/" },
    "rabbitmq": { "Url": "http://localhost:15672", "HealthPath": "/" },
    "otel-collector": { "Url": "http://localhost:13133", "HealthPath": "/" },
    "prometheus": { "Url": "http://localhost:9090", "HealthPath": "/-/healthy" },
    "grafana": { "Url": "http://localhost:3000", "HealthPath": "/api/health" }
  },
  // Parts of the demo without HTTP, checked by opening a TCP connection (host:port)
  "TcpServices": {
    "postgres": "localhost:54320"
  }
}
