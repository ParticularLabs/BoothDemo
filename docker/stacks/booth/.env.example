# Copy to .env next to compose.yaml on the Pi and fill in. .env is not committed.

# Azure Service Bus namespace the bridge forwards to (RootManageSharedAccessKey connection string)
AZURE_SERVICEBUS_CONNECTIONSTRING=

# Folder on the NVMe disk holding the RabbitMQ and PostgreSQL data (subfolders rabbitmq and postgres)
DATA_DIR=/mnt/nvme/booth

# PostgreSQL, used by the Sales endpoint and the ServiceControl instances
POSTGRES_USER=nsb
POSTGRES_PASSWORD=particular

PGADMIN_EMAIL=nsb@example.com
PGADMIN_PASSWORD=particular

# Image tag for all three ServiceControl instances
SERVICECONTROL_TAG=pr-6020

# ServicePulse deployed in Azure by scripts/deploy.ps1, added to the federated view (no trailing slash)
AZURE_SERVICEPULSE_URL=https://servicepulse.greenwater-803a0fdc.westeurope.azurecontainerapps.io

# ngrok tunnels to the primary ServiceControl instance and to the OTLP receiver for the Azure apps
NGROK_AUTHTOKEN=
NGROK_URL=https://techorama2026-sc.ngrok.dev
NGROK_OTLP_URL=https://techorama2026-otlp.ngrok.dev
