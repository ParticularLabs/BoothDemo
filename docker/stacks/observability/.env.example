# Copy to .env next to compose.yaml on the Pi and fill in. .env is not committed.

# Token Azure apps must send to the tunnel-exposed OTLP receiver (port 4319). Generate one with: openssl rand -hex 32
OTLP_PUBLIC_TOKEN=

# Same credentials as in the booth stack's .env
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
POSTGRES_USER=nsb
POSTGRES_PASSWORD=particular

GRAFANA_ADMIN_PASSWORD=

# Laptop running the Aspire AppHost (src/BoothDemo.AppHost), as <address>:18889
LAPTOP_OTLP_ENDPOINT=
